# ==============================================
# Agentic Creator OS - Backend Configuration
# ==============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================

# Server
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ==============================================
# Database (Docker - Local Development)
# ==============================================
# Default: Uses Docker PostgreSQL (docker-compose up -d db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_creator

# For Production: Use Supabase or another managed PostgreSQL
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ==============================================
# Redis (Docker - Local Development)
# ==============================================
# Default: Uses Docker Redis (docker-compose up -d redis)
REDIS_URL=redis://localhost:6379

# For Production: Use Upstash or another managed Redis
# REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# ==============================================
# Authentication
# ==============================================
# Generate a secure secret (min 32 characters):
#   openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# ==============================================
# Supabase (Required for Auth)
# ==============================================
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================
# Google Gemini (LLM)
# ==============================================
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# ==============================================
# YouTube OAuth
# ==============================================
# Get from: Google Cloud Console → APIs & Services → Credentials
# 1. Create OAuth 2.0 Client ID (Web application)
# 2. Add redirect URI: http://localhost:3000/api/auth/youtube/callback
YOUTUBE_CLIENT_ID=xxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-xxx

# ==============================================
# Push Notifications (Optional)
# ==============================================
# Get from: https://expo.dev → Account Settings → Access Tokens
EXPO_ACCESS_TOKEN=

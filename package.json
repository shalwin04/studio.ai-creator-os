{
  "name": "agentic-creator-os",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered operating system for YouTube creators",
  "keywords": [
    "expo",
    "react-native",
    "youtube",
    "creator",
    "ai",
    "agent"
  ],
  "author": "Agentic Creator OS",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "dev:mobile": "turbo dev --filter=@agentic-creator/mobile",
    "dev:backend": "turbo dev --filter=@agentic-creator/backend",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  }
}
